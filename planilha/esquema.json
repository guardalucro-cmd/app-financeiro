  "resumo": {
    "celulas": [
      {
        "ref": "Resumo!A1",
        "valor": "Mês (AAAA-MM)"
      },
      {
        "ref": "Resumo!B1",
        "valor": ""
      },
      {
        "ref": "Resumo!A3",
        "valor": "Entrou"
      },
      {
        "ref": "Resumo!B3",
        "formula": "=SUMPRODUCT((Lancamentos!H2:H=\"Receita\")*(LEFT(Lancamentos!B2:B;7)=IF(B1=\"\";TEXT(TODAY();\"yyyy-mm\");B1))*Lancamentos!D2:D)"
      },
      {
        "ref": "Resumo!A4",
        "valor": "Saiu"
      },
      {
        "ref": "Resumo!B4",
        "formula": "=SUMPRODUCT((Lancamentos!H2:H=\"Despesa\")*(LEFT(Lancamentos!B2:B;7)=IF(B1=\"\";TEXT(TODAY();\"yyyy-mm\");B1))*Lancamentos!D2:D)"
      },
      {
        "ref": "Resumo!A5",
        "valor": "Sobrou"
      },
      {
        "ref": "Resumo!B5",
        "formula": "=B3-B4"
      }
    ],
    "observacao": "Testado em 28/10/2026 numa planilha pt_BR: SUMPRODUCT com LEFT(data;7) funciona; SUMIFS com texto ISO e TEXT(...;\"aaaa-mm\") não funcionam. O app não depende do Resumo. Deixe B1 vazio para o mês atual ou digite AAAA-MM."
  }
